# Supabase Veritabanı Bağlantı Bilgileri
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Yeni Supabase projelerinde Connect ekranındaki publishable key'i kullanın.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Mevcut projeler için geçiş uyumluluğu; publishable key varsa bu zorunlu değil.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Canonical, sitemap, sosyal kart ve feed için tek yetkili alan adı
SITE_URL=https://www.muhammedakan.com
NEXT_PUBLIC_SITE_URL=https://www.muhammedakan.com

# CMS Yönetici Varsayılan Giriş Bilgileri
CMS_ADMIN_EMAIL=bilgi@muhammedakan.com
CMS_ADMIN_PASSWORD=replace_with_a_strong_unique_password
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_bytes
BLOG_OWNER_EMAIL=bilgi@muhammedakan.com
BLOG_REQUIRE_MFA=true
ALLOW_LEGACY_ADMIN_LOGIN=false

# Analytics v2 için ayrı, server-only pseudonimleştirme anahtarı
# `openssl rand -base64 48` ile ayrı bir değer üretin; browser'a açmayın.
ANALYTICS_HASH_SECRET=replace_with_a_separate_random_analytics_secret
ANALYTICS_V2_INGEST=true
ANALYTICS_RETENTION_DAYS=425
# Sunucu tarafı IP ağı konumlandırmasını kapatmak için false yapın.
ANALYTICS_IP_GEO_ENABLED=true
# Boşsa ip-api ücretsiz HTTP katmanı kullanılır. Pro anahtar HTTPS sağlar.
IP_API_KEY=

# Vercel Cron tarafından günlük analytics bakım çağrısı için
CRON_SECRET=replace_with_at_least_32_random_bytes

# Resend E-Posta Bildirim Servisi Anahtarı
RESEND_API_KEY=re_your_resend_api_key_here
# Blog bülteni için doğrulanmış gönderici ve yanıt adresi
BLOG_NEWSLETTER_FROM=Muhammed Akan Blog <noreply@muhammedakan.com>
BLOG_NEWSLETTER_REPLY_TO=bilgi@muhammedakan.com
# `openssl rand -base64 48` ile iki ayrı server-only sır üretin.
BLOG_NEWSLETTER_TOKEN_SECRET=replace_with_a_separate_random_token_secret
BLOG_PRIVACY_HASH_SECRET=replace_with_a_separate_random_privacy_hash_secret
# Resend dashboard'unda /api/blog/newsletter/webhooks/resend için üretilir.
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret
# Varsayılan false: açılma/tıklama olaylarını veritabanına kaydetmez.
BLOG_NEWSLETTER_ENGAGEMENT_TRACKING=false

# İsteğe bağlı Search Console / GA4 raporlama bağlantısı
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SEARCH_CONSOLE_PROPERTY=sc-domain:muhammedakan.com
GA4_PROPERTY_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Kademeli SEO CMS v2 geçişi
SEO_CMS_V2=true
